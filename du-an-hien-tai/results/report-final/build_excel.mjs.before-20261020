import fs from 'node:fs/promises';
import path from 'node:path';
import {execFileSync} from 'node:child_process';
import {FileBlob,SpreadsheetFile} from '@oai/artifact-tool';

const root='C:/Project/Badminton_Stock_Security';
const output=path.join(root,'results/report-final');
const python='C:/Users/vxg09/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe';
const workbook=await SpreadsheetFile.importXlsx(await FileBlob.load(path.join(output,'badminton_spec.before.xlsx')));
const mode=process.argv[2]||'preview';

async function render(sheetName,range,name){
  const blob=await workbook.render({sheetName,range,scale:1.4,format:'png'});
  await fs.writeFile(path.join(output,name),new Uint8Array(await blob.arrayBuffer()));
}

if(mode==='preview'){
  console.log((await workbook.inspect({kind:'sheet',include:'id,name',maxChars:3500})).ndjson);
  await render('ThongTin','A1:B4','excel-before-information.png');
  await render('TestCase','A1:C4','excel-before-cases.png');
}else if(mode==='edit'){
  const tables=JSON.parse(execFileSync(python,['-X','utf8','-B',path.join(root,'stock_json_fuzz.py'),'--print-spec'],{encoding:'utf8'}));
  for(const [sheetName,startRow,sourceRow,columns] of [['ThongTin',14,13,2],['TestCase',51,50,7]]){
    const sheet=workbook.worksheets.getItem(sheetName);
    const extra=tables[sheetName].slice(startRow-1);
    for(let i=0;i<extra.length;i++){
      const target=sheet.getRangeByIndexes(startRow+i-1,0,1,columns);
      target.copyFrom(sheet.getRangeByIndexes(sourceRow-1,0,1,columns),'all');
      target.values=[extra[i]];
      target.format.rowHeight=sheetName==='ThongTin'?44:58;
    }
  }
  workbook.recalculate();
  console.log((await workbook.inspect({kind:'region',sheetId:'ThongTin',range:'A14:B18',maxChars:4000})).ndjson);
  await render('ThongTin','A14:B18','excel-after-information.png');
  await render('TestCase','A51:C56','excel-after-case-names.png');
  await render('TestCase','D51:F56','excel-after-case-details.png');
  console.log((await workbook.inspect({kind:'match',searchTerm:'#REF!|#DIV/0!|#VALUE!|#NAME\\?|#NUM!|#NULL!',options:{useRegex:true,maxResults:20},maxChars:1500})).ndjson);
  const file=await SpreadsheetFile.exportXlsx(workbook);
  await file.save(path.join(output,'badminton_spec.updated.xlsx'));
}else{
  throw new Error('Unknown mode');
}
